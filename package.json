{
    "name": "commander-lab",
    "version": "0.1.0-test.8",
    "private": true,
    "description": "Manual Commander desktop playtester",
    "main": "main.cjs",
    "scripts": {
        "start": "node launch.cjs .",
        "test": "node --test tests/*.test.mjs",
        "test:ui": "node scripts/run-ui-tests.cjs",
        "test:ui:planeswalkers": "node launch.cjs tests/planeswalker-ui.cjs",
        "test:ui:mana": "node launch.cjs tests/mana-ui.cjs",
        "test:ui:combat": "node launch.cjs tests/combat-ui.cjs",
        "test:ui:goreclaw": "node launch.cjs tests/goreclaw-ui.cjs",
        "test:ui:hotseat": "node launch.cjs tests/hotseat-ui.cjs",
        "test:ui:spells": "node launch.cjs tests/spell-resolution-ui.cjs",
        "test:ui:aurelia": "node launch.cjs tests/aurelia-ui.cjs",
        "test:ui:network": "node launch.cjs tests/network-ui.cjs",
        "test:network": "node --test tests/network.test.mjs",
        "checklist": "node scripts/update-deck-checklist.mjs",
        "test:ui:controller": "node launch.cjs tests/controller-ui.cjs",
        "test:ui:aurelia-actions": "node launch.cjs tests/aurelia-actions-ui.cjs",
        "start:player2": "node launch.cjs . --profile=player2",
