        "test:ui:cast-popup": "node launch.cjs tests/cast-popup-ui.cjs",
        "test:ui:arahbo": "node launch.cjs tests/arahbo-ui.cjs",
        "test:ui:lobby": "node launch.cjs tests/lobby-ui.cjs",
        "test:ui:color-identity": "node launch.cjs tests/color-identity-ui.cjs",
        "decks:update": "node scripts/update-premade-decks.mjs",
        "decks:compare": "node scripts/compare-test-deck-names.mjs",
        "test:ui:vehicles": "node launch.cjs tests/vehicles-ui.cjs",
        "test:ui:arahbo-actions": "node launch.cjs tests/arahbo-actions-ui.cjs",
        "test:ui:isshin": "node launch.cjs tests/isshin-ui.cjs",
        "test:ui:fynn": "node launch.cjs tests/fynn-ui.cjs",
        "test:ui:talrand": "node launch.cjs tests/talrand-ui.cjs",
        "test:ui:mizzix": "node launch.cjs tests/mizzix-ui.cjs",
        "test:ui:kalamax": "node launch.cjs tests/kalamax-ui.cjs",
        "test:ui:niv-mizzet": "node launch.cjs tests/niv-mizzet-ui.cjs",
        "test:ui:kess": "node launch.cjs tests/kess-ui.cjs",
        "test:ui:theme": "node launch.cjs tests/theme-ui.cjs",
        "test:ui:turn-presentation": "node launch.cjs tests/turn-presentation-ui.cjs",
        "test:ui:counters": "node launch.cjs tests/counter-effects-ui.cjs",
        "test:ui:card-motion": "node launch.cjs tests/card-motion-ui.cjs",
        "test:ui:keywords": "node launch.cjs tests/keyword-icons-ui.cjs",
        "test:ui:tokens": "node launch.cjs tests/token-catalog-ui.cjs",
        "test:ui:playtest-decks": "node launch.cjs tests/playtest-decks-ui.cjs",
        "test:ui:keyword-actions": "node launch.cjs tests/keyword-actions-ui.cjs",
        "audit:keywords": "node scripts/audit-keywords.mjs",
        "audit:playtest-decks": "node scripts/audit-playtest-decks.mjs",
        "dist:win": "electron-builder --win --x64 --publish never && node scripts/release-checksums.mjs",
        "test:ui:atraxa-library": "node launch.cjs tests/atraxa-library-ui.cjs",
        "test:ui:atraxa-duration": "node launch.cjs tests/atraxa-duration-ui.cjs",
        "test:ui:atraxa-activations": "node launch.cjs tests/atraxa-activations-ui.cjs",
        "test:ui:entry-replacements": "node launch.cjs tests/entry-replacements-ui.cjs",
        "test:ui:entry-routes": "node launch.cjs tests/entry-routes-ui.cjs",
        "test:ui:updates": "node launch.cjs tests/updates-ui.cjs",
        "test:ui:pre-entry": "node launch.cjs tests/pre-entry-ui.cjs",
        "test:ui:entry-copy": "node launch.cjs tests/entry-copy-ui.cjs",
        "test:ui:damage-counters": "node launch.cjs tests/damage-counters-ui.cjs"
